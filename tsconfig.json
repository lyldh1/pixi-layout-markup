{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext",
    "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "rootDir": "./src"
  },
  "include": ["src"]
}

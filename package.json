{
  "name": "pixi-layout-markup",
  "version": "0.1.0",
  "description": "Build-time XML-to-native-code compiler for @pixi/layout.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "webpack-loader.cjs", "webpack-transform-loader.cjs", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "pixi-layout-markup": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vite": { "types": "./dist/vite.d.ts", "import": "./dist/vite.js" },
    "./rollup": { "types": "./dist/rollup.d.ts", "import": "./dist/rollup.js" },
    "./esbuild": { "types": "./dist/esbuild.d.ts", "import": "./dist/esbuild.js" },
    "./bun": { "types": "./dist/bun.d.ts", "import": "./dist/bun.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./compiler": { "types": "./dist/compiler.d.ts", "import": "./dist/compiler.js" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./webpack": "./webpack-loader.cjs",
    "./webpack-transform": "./webpack-transform-loader.cjs",
    "./rspack": "./webpack-loader.cjs",
    "./rspack-transform": "./webpack-transform-loader.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "gallery": "npm run build && vite --config examples/markup-gallery/vite.config.ts --host 127.0.0.1 --open",
    "build:gallery": "npm run build && tsc -p examples/markup-gallery/tsconfig.json --noEmit && vite build --config examples/markup-gallery/vite.config.ts",
    "build:examples": "npm run build:gallery",
    "test:e2e": "npm run build:examples && node --test examples/markup-gallery/test/*.test.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": ["pixijs", "layout", "xml", "markup", "vite", "webpack"],
  "peerDependencies": { "@pixi/layout": "^3.2.1", "@pixi/ui": "^2.3.2", "pixi.js": "^8.19.0" },
  "peerDependenciesMeta": { "@pixi/ui": { "optional": true } },
  "devDependencies": {
    "@pixi/layout": "^3.2.1", "@pixi/ui": "^2.3.2", "@types/node": "^26.2.0",
    "pixi.js": "^8.19.0", "playwright-core": "^1.62.1", "vite": "^7.0.0"
  },
  "dependencies": { "fast-xml-parser": "^5.11.0", "source-map-js": "^1.2.1", "typescript": "^5.9.0" }
}

<LayoutContainer width="100%" height="100%" gap="22" flexDirection="column" justifyContent="center" alignItems="center">
  <FancyButton id="fancy" width="260" height="70" text="FANCY BUTTON" padding="12" signal.onPress="press">
    <FancyButton.defaultView><Graphics><RoundRect x="0" y="0" width="260" height="70" radius="16" /><Fill color="#2563eb" /><Stroke color="#93c5fd" width="3" /></Graphics></FancyButton.defaultView>
    <FancyButton.hoverView><Graphics><RoundRect x="0" y="0" width="260" height="70" radius="16" /><Fill color="#3b82f6" /><Stroke color="#dbeafe" width="4" /></Graphics></FancyButton.hoverView>
    <FancyButton.pressedView><Graphics><RoundRect x="0" y="0" width="260" height="70" radius="16" /><Fill color="#1d4ed8" /><Stroke color="#60a5fa" width="3" /></Graphics></FancyButton.pressedView>
  </FancyButton>
  <Text id="status" text="Hover, press and release" tint="#cbd5e1" layout="true" />
</LayoutContainer>
